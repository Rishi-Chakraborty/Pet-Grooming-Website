# ── SMTP (for booking email + calendar invite) ──────────────────────────────
# Use any SMTP provider (Gmail App Password, Zoho, SendGrid, Brevo, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# Where booking notifications are sent (the business owner's inbox)
MAIL_TO=owner@superpetgrooming.com
# The "from" address shown on emails/invites
MAIL_FROM=bookings@superpetgrooming.com

# Note: If SMTP vars are absent, the site still works — bookings are logged to
# data/bookings.xlsx and the customer sees the confirmation message. Email/
# calendar sync simply stays off until you fill these in.
